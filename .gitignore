# Konfigurasi lokal berisi kredensial database — JANGAN di-push
config/koneksi.php

# File environment / rahasia lainnya
.env
.env.*
*.local.php

# Kecuali konfigurasi email: sengaja ikut di-commit agar langsung jalan di VPS.
!config/mail.local.php

# Upload & data runtime (isi storage, bukan foldernya)
# Bukti pembayaran hanya disimpan di VPS, jangan pernah masuk GitHub.
storage/uploads/*
storage/uploads/**
!storage/uploads/.gitkeep
storage/avatars/*
storage/avatars/**
!storage/avatars/.gitkeep

# Penanda pembersihan otomatis harian
storage/uploads/.pembersihan_terakhir

# Artefak tool/editor
.freebuff/
.idea/
.vscode/
*.swp
.DS_Store

# Log
*.log

# Dokumen & Laporan non-kode (Proposal, Milestone, kekurangan.md, Jobsheet, docx, dsb)
/laporan/*
!/laporan/*.php

# Diagram dan aset dokumen/laporan
docs/diagrams/

# File media rekaman / video demo / audio di storage
storage/*.mp4
storage/*.mp3
storage/*.wav

# Konteks AI, desain, & project eksternal
AGENTS.md
DESIGN.md
PRODUCT.md
.impeccable/
.commandcode/
.dist/
projects/
